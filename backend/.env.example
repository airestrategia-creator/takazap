# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legado: desde a versão multi-tenant a organização vem do vínculo do usuário.
# Pode deixar em branco.
DEFAULT_ORGANIZATION_ID=

# Porta da API
PORT=3333

# Segredo para validar tokens de sessão do painel (se não usar Supabase Auth direto)
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Origem permitida no CORS (URL do frontend em produção)
FRONTEND_ORIGIN=http://localhost:5173

# Pasta onde as credenciais do WhatsApp (Baileys) ficam salvas
WHATSAPP_AUTH_DIR=./storage/whatsapp-auth

# Google Places API (usado na tela de Prospecção para buscar estabelecimentos
# do Google Meu Negócio por categoria/região). Crie em console.cloud.google.com
# → ative "Places API" → crie uma chave de API → habilite faturamento
# (o Google cobra por chamada, mas dá crédito gratuito mensal).
GOOGLE_PLACES_API_KEY=

# Pagamento da assinatura.
# PAYMENT_PROVIDER=manual → a cobrança PIX é registrada e o dono da conta
# confirma o pagamento no painel. Ao plugar um provedor de verdade (Mercado
# Pago, Asaas, Efí), implemente-o em src/services/payments.js e troque aqui.
PAYMENT_PROVIDER=manual

# Chave PIX que recebe os pagamentos (usada pelo provider manual)
PIX_KEY=
